# Database — prefer Neon pooled URL for cloud, or local Postgres for offline
# Neon (recommended):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon connections verify the TLS certificate (rejectUnauthorized: true)
# Quick setup: ./scripts/use-neon.sh "<your-neon-url>"
# See docs/NEON.md
DATABASE_URL=postgresql://ethio:ethio@localhost:5432/project_manager?schema=public

# NestJS API
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Postgres pool size per process (Vercel defaults to 1 if unset)
# DATABASE_POOL_MAX=10

# Set true to expose /api/docs in production (on by default in development)
# ENABLE_SWAGGER=true

# Optional email (password reset)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Optional Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Next.js (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
